{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/downloads/pageqa-ai-extension.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"pageqa-ai-extension.zip\""
        },
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
